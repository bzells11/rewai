PORT=3001

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Twilio (platform account — used to send from wholesalers' numbers)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...

# Public demo. DEMO_MODE=true simulates every Twilio send, mounts /demo, pauses the follow-up cron.
DEMO_MODE=false
# DEMO_ROUTES=true mounts /demo only, so one backend can serve the demo while real texting still works.
DEMO_ROUTES=false
# Demo caps
DEMO_MAX_ACTIONS_PER_HOUR=40
DEMO_MAX_ACTIONS_PER_DAY=5000
DEMO_SESSION_TTL_MINUTES=60
DEMO_MAX_SESSIONS=500
